  "item": [
    {
      "name": "1 - GET Productos (listar)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/productos",
          "host": ["http://localhost:8080/api"],
          "path": ["productos"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2 - POST Producto (crear)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Shampoo Wolf\",\n  \"descripcion\": \"Shampoo para cabello\",\n  \"precio\": 25000,\n  \"stock\": 20,\n  \"categoria\": \"Cabello\",\n  \"activo\": true\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/productos",
          "host": ["http://localhost:8080/api"],
          "path": ["productos"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 201 o 200\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "",
              "if(jsonData.datos && jsonData.datos.id){",
              "    pm.environment.set(\"productId\", jsonData.datos.id);",
              "} else if(jsonData.dato && jsonData.dato.id){",
              "    pm.environment.set(\"productId\", jsonData.dato.id);",
              "} else if(jsonData.id){",
              "    pm.environment.set(\"productId\", jsonData.id);",
              "}",
              "",
              "pm.test(\"Producto creado y guardado en variable productId\", function(){",
              "    pm.expect(pm.environment.get(\"productId\")).to.not.be.undefined;",
              "});"
            ]
          }
        }
      ]
    },
